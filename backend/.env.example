# Stock Radar System — Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/stock_radar

# API
API_HOST=0.0.0.0
API_PORT=8000
# Secret key used for JWT signing AND as the API key for /auth/token.
# Generate a strong random value for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=change-me-in-production

# Trading Parameters
TRADING_MODE=paper
MAX_POSITION_SIZE=5000.0
MAX_CONCURRENT_POSITIONS=5
STOP_LOSS_PCT=0.05
DAILY_LOSS_LIMIT=500.0
TARGET_PROFIT_PER_SHARE_MIN=0.10
TARGET_PROFIT_PER_SHARE_MAX=0.25

# Universe Filter
UNIVERSE_MIN_PRICE=1.0
UNIVERSE_MAX_PRICE=10.0
UNIVERSE_MIN_VOLUME=100000

# Broker — "mock" for simulated, "ibkr" for real IBKR
BROKER_TYPE=mock

# IBKR Connection
# Port reference:
#   TWS Paper:     7497    TWS Live:     7496
#   Gateway Paper:  4002    Gateway Live:  4001
# Use Gateway ports (4001/4002) for headless VPS deployment via IBC.
# Use TWS ports (7496/7497) for local development with TWS GUI.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_TIMEOUT=30
IBKR_MAX_RECONNECT_ATTEMPTS=10
